{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "outDir": "src",
    "rootDir": "ts",
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "types": [
      "chrome"
    ]
  },
  "include": [
    "ts/**/*.ts"
  ]
}
