{
  "name": "pixelcatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extensión Chrome MV3 que detecta y guarda imágenes de páginas con galería previa, ZIP o carpeta. Sin telemetría.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build --silent && node scripts/check.mjs",
    "test": "npm run build --silent && node --test test/unit/*.test.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "typescript": "^7.0.2"
  }
}
